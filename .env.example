# Copy to .env only if it does not exist. Keep credentials out of chat and Git.
# `pnpm exec rocketride init --uri https://staging.rocketride.ai` writes
# the actual RocketRide connection values after browser sign-in.
ROCKETRIDE_URI=https://staging.rocketride.ai
ROCKETRIDE_APIKEY=
ROCKETRIDE_DEPLOY_URI=https://staging.rocketride.ai
ROCKETRIDE_DEPLOY_APIKEY=

# Cognee's keyless local demo works without a provider key.
# Set this only when using your own LLM for new document extraction.
LLM_API_KEY=

# Cognee Cloud uses its own credentials and prepaid processing credits.
# Copy the actual tenant API URL and existing key from the Cloud API Keys page.
COGNEE_SERVICE_URL=
COGNEE_API_KEY=

# Optional alternatives to hotdata browser login and workspace selection.
HOTDATA_API_KEY=
HOTDATA_WORKSPACE=

# Rote login stores its token in sponsor-setup/rote/.runtime/ (Git-ignored).
