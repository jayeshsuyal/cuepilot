#!/bin/sh
# Use the pinned Play Python dependencies and this project's authenticated Rote.
set -eu
rote_setup_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export ROTE_HOME="$rote_setup_dir/.runtime"
export PATH="$rote_setup_dir/.play-venv/bin:$rote_setup_dir:$HOME/.local/bin:$PATH"
exec "$HOME/.local/bin/play" "$@"
