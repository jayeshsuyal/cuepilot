{
  "name": "cuepilot-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:dependencies": "pnpm security:node",
    "check:source": "pnpm security:code",
    "security:code": "node verification/security.mjs code",
    "security:node": "node verification/security.mjs node",
    "security:scan": "node verification/security.mjs all",
    "verify:transport": "node --import tsx --test verification/transport.test.ts",
    "verify:operator": "node --import tsx --test verification/operator.test.ts",
    "format:check": "prettier --check src vite.config.ts"
  },
  "dependencies": {
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
